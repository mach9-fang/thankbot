# Public URL of the deployment (used for Google OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://thankbot.previewmach9.com

# Supabase project — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://qewqxlzvlpgmhwibkfig.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Only needed for `pnpm seed` and Slack writes (server-side only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Slack slash command `/thanks` — from api.slack.com → Your App → Basic Information / OAuth
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Local testing only — skips HMAC verification (never enable in production)
SLACK_SKIP_VERIFY=false

# Debug only: lets you thank yourself so one person can test the flow.
# Leave unset (or "false") in production.
NEXT_PUBLIC_ALLOW_SELF_THANKS=false
